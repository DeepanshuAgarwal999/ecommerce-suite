# Leave unset in development: the app derives the gateway from the Metro host
# (LAN IP on a phone, 10.0.2.2 on the Android emulator) - see src/config/env.ts.
# Set it to point a dev build at another gateway, e.g. the deployed one.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1

# Android push: path to the Firebase project google-services.json (never commit it).
# GOOGLE_SERVICES_FILE=./google-services.json
