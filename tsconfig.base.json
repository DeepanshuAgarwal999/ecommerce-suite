{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "paths": {
      "@ecommerce/common": ["./libs/common/src/index.ts"],
      "@ecommerce/contracts": ["./libs/contracts/src/index.ts"],
      "@ecommerce/kafka": ["./libs/kafka/src/index.ts"],
      "@ecommerce/redis": ["./libs/redis/src/index.ts"],
      "@ecommerce/auth": ["./libs/auth/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
