# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Every service reads this same file.
# In Docker/Kubernetes the same keys are injected as environment variables.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
PRETTY_LOGS=true

# --- HTTP ports (local dev, one per service) --------------------------------
# api-gateway is the only service that should be exposed publicly.
PORT=3000

# --- Databases (database-per-service) ---------------------------------------
# `tools/scripts/prisma.mjs` maps <SERVICE>_DATABASE_URL to DATABASE_URL per schema.
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AUTH_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/auth_db?schema=public
USER_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/user_db?schema=public
CATALOG_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/catalog_db?schema=public
INVENTORY_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/inventory_db?schema=public
CART_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/cart_db?schema=public
ORDER_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/order_db?schema=public
PAYMENT_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/payment_db?schema=public
NOTIFICATION_SERVICE_DATABASE_URL=postgresql://ecom:ecom@localhost:5432/notification_db?schema=public

# Connection pool per replica. With many replicas, front Postgres with PgBouncer
# (transaction pooling) and keep this small.
DB_POOL_SIZE=10

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=
REDIS_CLUSTER=false

# --- Kafka ------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_IDEMPOTENT_PRODUCER=true
KAFKA_AUTO_CREATE_TOPICS=true

# --- Internal RPC (TCP) -----------------------------------------------------
# Each domain service listens on TCP_PORT for the gateway. Hosts default to
# localhost for local dev; docker-compose overrides them to the service names.
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_TCP_PORT=4001
USER_SERVICE_HOST=localhost
USER_SERVICE_TCP_PORT=4002
CATALOG_SERVICE_HOST=localhost
CATALOG_SERVICE_TCP_PORT=4003
INVENTORY_SERVICE_HOST=localhost
INVENTORY_SERVICE_TCP_PORT=4004
CART_SERVICE_HOST=localhost
CART_SERVICE_TCP_PORT=4005
ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_TCP_PORT=4006
PAYMENT_SERVICE_HOST=localhost
PAYMENT_SERVICE_TCP_PORT=4007
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_TCP_PORT=4008

# --- Auth / JWT -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Both must be >= 32 chars in production; the config module refuses to boot otherwise.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-minimum
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=ecommerce-platform
JWT_AUDIENCE=ecommerce-clients

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=15
DEFAULT_COUNTRY_CODE=+91
DEFAULT_PHONE_REGION=IN
# Dev only: accept this fixed code instead of sending an SMS. Must be unset in prod.
OTP_DEV_FIXED_CODE=123456

# --- Dev admin seed ----------------------------------------------------------
# `npm run db:seed` grants this mobile number the SUPER_ADMIN role (apps/auth-service/prisma/seed.ts).
# Sign in to frontend/admin with this number + the fixed OTP above - no real SMS needed.
# Leave empty to skip seeding an admin. Never set this in a real environment.
ADMIN_MOBILE=9999999999

# --- Clients (app + web) ----------------------------------------------------
# Browser origins allowed to call the API with credentials (comma-separated).
# '*' disables credentials, which breaks web sign-in - list real hosts in prod.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200,http://localhost:4201,http://localhost:4300,http://localhost:5173
# Native builds below these get 426 Upgrade Required. Leave empty to disable.
MIN_APP_VERSION_ANDROID=
MIN_APP_VERSION_IOS=
# Refresh-token cookie for web clients (httpOnly). Secure must be true in prod.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# --- Rate limiting (gateway) ------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=600
THROTTLE_ANON_LIMIT=30
REQUEST_TIMEOUT_MS=15000
RPC_TIMEOUT_MS=10000

# --- Razorpay ---------------------------------------------------------------
# Test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in Dashboard -> Webhooks; must match what you enter there.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR
RAZORPAY_AUTO_CAPTURE=true

# --- Firebase Cloud Messaging -----------------------------------------------
# Either point at a service-account JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=
# ...or supply the three fields inline (private key with literal \n).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_BATCH_SIZE=500

# --- SMS --------------------------------------------------------------------
# console | msg91
SMS_PROVIDER=console
SMS_SENDER_ID=ECOMRC
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5

# --- Business rules (amounts in paise) --------------------------------------
FREE_SHIPPING_THRESHOLD=49900
DEFAULT_SHIPPING_FEE=4900
COD_FEE=2900
DEFAULT_TAX_BPS=1800
STOCK_HOLD_SECONDS=900
QUICK_COMMERCE_SLA_MINUTES=15
