// order-service owns the order aggregate and orchestrates the checkout saga.
//
// An order is an immutable financial record with a mutable status. Everything that
// affects money - prices, titles, the delivery address, the tax rate - is copied onto
// the order at placement time. If a vendor renames a product or changes its price a week
// later, the customer's invoice must not change with it. That is why this schema
// duplicates so much data that "already exists" in other services.
//
// The saga: reserve stock -> take payment -> confirm. Each step publishes an event and
// each failure publishes a compensating one. `SagaState` tracks where an order is in
// that dance so a crashed instance can be resumed rather than leaving stock held forever.

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@ecom-db/order"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  CANCELLED
  SHIPPED
  DELIVERED
  RETURNED
}

enum FulfilmentType {
  STANDARD
  QUICK_COMMERCE
  SCHEDULED
}

enum PaymentMethod {
  /// Pay online through the active gateway; the actual instrument (UPI, card...) is
  /// recorded on the payment once the shopper has paid.
  ONLINE
  UPI
  CARD
  NETBANKING
  WALLET
  EMI
  PAY_LATER
  COD
}

enum SagaStatus {
  STARTED
  AWAITING_INVENTORY
  AWAITING_PAYMENT
  COMPLETED
  COMPENSATING
  COMPENSATED
  FAILED
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  /// Customer-facing, non-sequential. See `generateOrderNumber` for why.
  orderNumber String @unique @db.VarChar(24)

  userId      String  @db.Uuid
  userMobile  String  @db.VarChar(20)
  userEmail   String? @db.VarChar(255)

  status         OrderStatus    @default(DRAFT)
  fulfilmentType FulfilmentType @default(STANDARD)

  /// Channel the order was placed from (ANDROID, IOS, WEB, ...). The one column every
  /// analytics question about app-vs-web conversion needs.
  source     String  @default("API") @db.VarChar(20)
  appVersion String? @db.VarChar(20)

  currency String @default("INR") @db.VarChar(3)

  /// All amounts are integer paise. The identity
  ///   grandTotal = itemTotal - discountTotal + shippingTotal + taxTotal + codFee
  /// must hold for every row; it is asserted when the order is built.
  itemTotal     Int
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  codFee        Int @default(0)
  grandTotal    Int

  couponCode String? @db.VarChar(40)

  paymentMethod PaymentMethod
  /// Set once payment-service reports a capture. Nullable for COD until delivery.
  paymentId     String?       @db.Uuid
  paidAt        DateTime?

  /// The delivery address as it was at placement, not a pointer to a mutable row -
  /// editing a saved address must never rewrite where a past order was shipped.
  shippingAddress Json

  /// Set by inventory-service when the hold is granted.
  reservationId String? @db.Uuid

  expectedDeliveryAt DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.VarChar(400)
  cancelledBy        String?   @db.Uuid

  /// Client-supplied key that makes "place order" safe to retry. Unique, so a duplicate
  /// submission hits a constraint instead of creating a second order.
  idempotencyKey String? @unique @db.VarChar(128)

  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  statusHistory OrderStatusHistory[]
  saga        SagaState?
  shipments   Shipment[]
  returns     ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String @db.Uuid
  variantId String @db.Uuid
  sku       String @db.VarChar(64)

  /// Vendor is on the line, not the order: one basket can span several sellers, and
  /// each vendor is settled and ships separately.
  vendorId   String @db.Uuid
  vendorName String @db.VarChar(200)

  /// Frozen copies. See the note at the top of this file.
  title    String  @db.VarChar(300)
  imageUrl String? @db.VarChar(500)
  options  Json?

  quantity  Int
  unitPrice Int
  unitMrp   Int
  /// This line's share of any order-level discount, distributed proportionally so
  /// per-item refunds still sum to the amount actually charged.
  discount  Int @default(0)
  taxBps    Int @default(1800)
  taxAmount Int @default(0)
  lineTotal Int

  status OrderItemStatus @default(PENDING)

  /// Which warehouse this line ships from - decided at reservation time.
  warehouseId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returnItems ReturnItem[]

  @@index([orderId])
  @@index([vendorId, status])
  @@index([sku])
  @@map("order_items")
}

/// Every status transition, with who and why. Customer support lives in this table.
model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?      @db.VarChar(400)
  changedBy  String?      @db.Uuid
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Checkout saga state machine.
///
/// Without this, a crash between "stock reserved" and "payment captured" leaves stock
/// held with nothing to release it. The recovery job scans for stale rows and drives
/// them to a terminal state.
model SagaState {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status SagaStatus @default(STARTED)
  /// Human-readable marker of the last completed step, for debugging a stuck saga.
  currentStep String @db.VarChar(60)

  inventoryReserved Boolean @default(false)
  paymentCaptured   Boolean @default(false)
  inventoryCommitted Boolean @default(false)

  /// Set when compensation runs, so a retried failure does not double-refund.
  compensationStartedAt DateTime?
  compensationDoneAt    DateTime?

  failureReason String? @db.VarChar(500)
  attempts      Int     @default(0)
  /// Deadline after which the recovery sweep takes over.
  timeoutAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, timeoutAt])
  @@map("saga_states")
}

model Shipment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// One shipment per vendor per order in the common multi-seller case.
  vendorId String @db.Uuid

  courierName    String? @db.VarChar(120)
  trackingNumber String? @db.VarChar(80)
  trackingUrl    String? @db.VarChar(500)

  /// Set for quick-commerce orders being run by a delivery partner.
  deliveryPartnerId String? @db.Uuid

  status      String    @db.VarChar(40)
  shippedAt   DateTime?
  deliveredAt DateTime?
  /// Proof of delivery: OTP confirmation or a photo key.
  deliveryProof String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ReturnRequest {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String @db.Uuid

  reason      String  @db.VarChar(300)
  description String? @db.VarChar(1000)
  imageUrls   String[]

  status String @default("REQUESTED") @db.VarChar(40)

  /// Amount to refund once the return is received. Computed from the item lines, so it
  /// can never exceed what was charged.
  refundAmount Int
  refundId     String? @db.Uuid

  approvedBy String?   @db.Uuid
  approvedAt DateTime?
  pickedUpAt DateTime?
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReturnItem[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id       String        @id @default(uuid()) @db.Uuid
  returnId String        @db.Uuid
  return   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity Int
  amount   Int

  @@index([returnId])
  @@map("return_items")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  topic         String   @db.VarChar(120)
  eventType     String   @db.VarChar(120)
  eventVersion  Int      @default(1)
  partitionKey  String   @db.VarChar(120)
  payload       Json
  correlationId String?  @db.VarChar(128)
  causationId   String?  @db.VarChar(128)
  actorId       String?  @db.VarChar(64)
  /// Client source of the originating request (ANDROID, IOS, WEB, ...), for attribution.
  source        String?  @db.VarChar(20)

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId       String   @id @db.VarChar(64)
  consumerGroup String   @db.VarChar(120)
  processedAt   DateTime @default(now())

  @@index([processedAt])
  @@map("processed_events")
}
