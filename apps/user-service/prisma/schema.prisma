// user-service owns the customer profile, delivery addresses and vendor onboarding.
//
// It deliberately does NOT own credentials - those stay in auth-service. What it keeps
// is a copy of the identifying fields (mobile, email) synced from `auth.user.registered`,
// so profile and address queries never need a cross-service call. That duplication is
// the price of service autonomy, and it is bounded: auth-service remains the only
// writer of identity, this service is a read replica of it.

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@ecom-db/user"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum VendorStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model UserProfile {
  /// Same UUID as `Identity.id` in auth-service. Shared ids let the two services join
  /// conceptually without a foreign key across databases.
  id String @id @db.Uuid

  mobile      String  @db.VarChar(20)
  countryCode String  @default("+91") @db.VarChar(6)
  email       String? @db.VarChar(255)

  firstName   String?   @db.VarChar(80)
  lastName    String?   @db.VarChar(80)
  displayName String?   @db.VarChar(160)
  avatarUrl   String?   @db.VarChar(500)
  gender      Gender    @default(UNDISCLOSED)
  dateOfBirth DateTime? @db.Date

  /// Free-form app preferences (language, theme, saved filters). JSONB keeps product
  /// experiments out of the migration path.
  preferences Json?

  referralCode String? @unique @db.VarChar(12)
  /// Denormalised counters. Recomputing these from the order service on every profile
  /// load would put a join on the hottest read path in the app.
  orderCount   Int     @default(0)
  totalSpent   Int     @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  addresses Address[]
  vendor    Vendor?

  @@index([mobile])
  @@index([createdAt])
  @@map("user_profiles")
}

model Address {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @db.Uuid
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       AddressType @default(HOME)
  fullName    String      @db.VarChar(120)
  /// Delivery contact, which is often not the account holder (gifts, family orders).
  phone       String      @db.VarChar(20)
  alternatePhone String?  @db.VarChar(20)

  line1     String  @db.VarChar(255)
  line2     String? @db.VarChar(255)
  landmark  String? @db.VarChar(160)
  city      String  @db.VarChar(120)
  state     String  @db.VarChar(120)
  /// Drives serviceability, delivery SLA and which dark store fulfils the order.
  pincode   String  @db.VarChar(12)
  country   String  @default("India") @db.VarChar(80)

  /// Captured from the device when available - quick-commerce routing needs the exact
  /// drop point, not just the pincode centroid.
  latitude  Float?
  longitude Float?

  isDefault Boolean   @default(false)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isDeleted])
  @@index([pincode])
  @@map("addresses")
}

/// Vendor (seller) onboarding. A vendor is a user who has been approved to list
/// products, which is why this hangs off UserProfile rather than being its own account.
model Vendor {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @unique @db.Uuid
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName  String  @db.VarChar(200)
  legalName     String? @db.VarChar(200)
  /// Short code used as the SKU prefix for everything this vendor sells.
  vendorCode    String  @unique @db.VarChar(12)
  description   String? @db.VarChar(2000)
  logoUrl       String? @db.VarChar(500)

  /// Indian tax/registration identifiers. Stored as given; verification is a manual
  /// admin step recorded in `reviewedBy`/`reviewedAt`.
  gstin      String? @db.VarChar(20)
  pan        String? @db.VarChar(12)
  fssaiLicense String? @db.VarChar(20)

  supportEmail String? @db.VarChar(255)
  supportPhone String? @db.VarChar(20)

  pickupAddress Json?

  /// Settlement account. Kept minimal on purpose - full bank details belong with the
  /// payout provider, not in the application database.
  bankAccountLast4 String? @db.VarChar(4)
  bankIfsc         String? @db.VarChar(16)
  razorpayAccountId String? @db.VarChar(64)

  status         VendorStatus @default(PENDING)
  rejectionReason String?     @db.VarChar(500)
  reviewedBy     String?      @db.Uuid
  reviewedAt     DateTime?

  /// Platform commission in basis points (1500 = 15%).
  commissionBps Int @default(1500)

  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents VendorDocument[]

  @@index([status])
  @@index([createdAt])
  @@map("vendors")
}

model VendorDocument {
  id       String @id @default(uuid()) @db.Uuid
  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// GST_CERTIFICATE, PAN_CARD, CANCELLED_CHEQUE, FSSAI...
  type     String  @db.VarChar(50)
  /// Object-storage key, never a public URL - these are KYC documents.
  storageKey String @db.VarChar(500)
  verified Boolean @default(false)
  notes    String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([vendorId, type])
  @@map("vendor_documents")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  topic         String   @db.VarChar(120)
  eventType     String   @db.VarChar(120)
  eventVersion  Int      @default(1)
  partitionKey  String   @db.VarChar(120)
  payload       Json
  correlationId String?  @db.VarChar(128)
  causationId   String?  @db.VarChar(128)
  actorId       String?  @db.VarChar(64)
  /// Client source of the originating request (ANDROID, IOS, WEB, ...), for attribution.
  source        String?  @db.VarChar(20)

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Consumer-side dedupe table. Redis handles this on the hot path; this is the durable
/// backstop so a Redis flush cannot cause an event to be applied twice.
model ProcessedEvent {
  eventId     String   @id @db.VarChar(64)
  consumerGroup String @db.VarChar(120)
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_events")
}
