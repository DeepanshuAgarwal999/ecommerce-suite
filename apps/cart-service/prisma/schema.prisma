// cart-service owns the pre-purchase basket and the wishlist.
//
// The cart is read and written far more often than anything else in the system - every
// scroll, every "add to bag" - so the live cart lives in Redis and Postgres is the
// durable copy. Redis absorbs the traffic; Postgres means a cart survives a cache flush
// and is still there when the customer opens the app on a different device.
//
// Prices are snapshotted onto the line at add-time. If the price moves before checkout,
// checkout re-prices against catalog-service and tells the customer what changed rather
// than silently charging a different amount.

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@ecom-db/cart"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CartStatus {
  ACTIVE
  /// Frozen during checkout so a second tab cannot mutate it mid-order.
  LOCKED
  CONVERTED
  ABANDONED
}

enum CouponType {
  PERCENTAGE
  FLAT
  FREE_SHIPPING
}

model Cart {
  id     String @id @default(uuid()) @db.Uuid
  /// One active cart per user. Guest carts key on a device id until the user signs in,
  /// at which point the two are merged.
  userId String @unique @db.Uuid

  status CartStatus @default(ACTIVE)

  couponCode     String? @db.VarChar(40)
  couponDiscount Int     @default(0)

  /// Cached totals so the badge and mini-cart render without recomputing every line.
  /// Authoritative totals are always recomputed at checkout.
  itemCount  Int @default(0)
  itemTotal  Int @default(0)

  /// Chosen at checkout; kept here so a resumed checkout remembers the selection.
  addressId String? @db.Uuid

  lockedAt   DateTime?
  convertedOrderId String? @db.Uuid
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([status, lastActivityAt])
  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String @db.Uuid
  variantId String @db.Uuid
  sku       String @db.VarChar(64)
  vendorId  String @db.Uuid

  /// Display fields copied from catalog so rendering the cart needs no fan-out call.
  title    String  @db.VarChar(300)
  imageUrl String? @db.VarChar(500)
  /// e.g. `{ "color": "Blue", "size": "M" }`
  options  Json?

  quantity Int @default(1)

  /// Price when the item was added. Compared against the live price at checkout.
  unitPrice Int
  unitMrp   Int

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A variant appears at most once per cart; adding again bumps the quantity.
  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  productId String  @db.Uuid
  variantId String? @db.Uuid
  title     String  @db.VarChar(300)
  imageUrl  String? @db.VarChar(500)
  /// Price at save time, so the app can show "price dropped" without a history table.
  priceAtSave Int

  createdAt DateTime @default(now())

  @@unique([userId, productId, variantId])
  @@index([userId, createdAt])
  /// Admin insights: "most wishlisted" groups by product.
  @@index([productId, createdAt])
  @@map("wishlist_items")
}

/// Promotional codes. Validation happens here so the same rules apply to cart preview
/// and to the final order total.
model Coupon {
  id   String     @id @default(uuid()) @db.Uuid
  code String     @unique @db.VarChar(40)
  type CouponType @default(PERCENTAGE)

  /// Percentage in basis points, or a flat amount in paise, depending on `type`.
  value Int
  /// Ceiling on a percentage discount, so "50% off" cannot cost more than intended.
  maxDiscount Int?
  minOrderValue Int @default(0)

  description String? @db.VarChar(300)

  /// Empty means "applies to everything".
  applicableCategoryIds String[]
  applicableVendorIds   String[]

  /// Global cap and per-user cap. Redemption is counted atomically at order creation,
  /// not here, so a burst of concurrent checkouts cannot overshoot the budget.
  usageLimit    Int?
  usageCount    Int  @default(0)
  perUserLimit  Int  @default(1)
  /// Restricts the code to customers who have never ordered.
  firstOrderOnly Boolean @default(false)

  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId   String @db.Uuid
  orderId  String @db.Uuid
  discount Int

  createdAt DateTime @default(now())

  /// Enforces the per-user limit at the database level, where it cannot be raced.
  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  topic         String   @db.VarChar(120)
  eventType     String   @db.VarChar(120)
  eventVersion  Int      @default(1)
  partitionKey  String   @db.VarChar(120)
  payload       Json
  correlationId String?  @db.VarChar(128)
  causationId   String?  @db.VarChar(128)
  actorId       String?  @db.VarChar(64)
  /// Client source of the originating request (ANDROID, IOS, WEB, ...), for attribution.
  source        String?  @db.VarChar(20)

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId       String   @id @db.VarChar(64)
  consumerGroup String   @db.VarChar(120)
  processedAt   DateTime @default(now())

  @@index([processedAt])
  @@map("processed_events")
}
