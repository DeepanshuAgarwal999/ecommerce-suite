// catalog-service owns the product model: categories, brands, products, variants,
// attributes, media and reviews.
//
// The product/variant split is the central decision. A "product" is what a customer
// browses to ("Cotton Kurta"); a "variant" is what they actually buy ("Cotton Kurta /
// Blue / M"), and it is the variant that carries the SKU, the price and the stock. Every
// commerce platform that skips this split ends up bolting it on later, painfully.
//
// Note what is NOT here: stock counts. Availability changes thousands of times more often
// than product copy does, and mixing the two would make every product read contend with
// inventory writes. Stock lives in inventory-service, keyed by SKU.

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@ecom-db/catalog"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(160)
  slug     String  @unique @db.VarChar(180)

  /// Self-referencing tree. Depth is small (3-4 levels), so recursive CTEs are cheap and
  /// the whole tree is cached in Redis anyway.
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  /// Materialised path (`/fashion/men/kurtas`) so "everything under Fashion" is a single
  /// prefix scan instead of a recursive walk.
  path     String  @db.VarChar(500)
  level    Int     @default(0)

  description String? @db.VarChar(1000)
  imageUrl    String? @db.VarChar(500)
  iconUrl     String? @db.VarChar(500)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  /// Surfaced on the home screen shelf.
  isFeatured   Boolean @default(false)

  /// Category-level tax rate in basis points; products inherit unless they override.
  taxBps Int @default(1800)

  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(400)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId, displayOrder])
  @@index([path])
  @@index([isActive, isFeatured])
  @@map("categories")
}

model Brand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(160)
  slug        String  @unique @db.VarChar(180)
  logoUrl     String? @db.VarChar(500)
  description String? @db.VarChar(1000)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  /// Owning vendor, mirrored from user-service. Not a foreign key - it points into
  /// another service's database.
  vendorId   String @db.Uuid
  vendorName String @db.VarChar(200)

  /// Who created this listing - VENDOR_WEB (self-listed, the common case) or ADMIN_WEB
  /// (staff listed it on the vendor's behalf). Same ClientSource values and the same
  /// "default API" convention as Order.source; populated from RequestContext.source,
  /// never client-supplied, so it can't be spoofed into looking vendor-authored.
  source String @default("API") @db.VarChar(20)

  /// Staff-entered sourcing metadata for a listing imported/reference from another
  /// marketplace (Meesho, Flipkart, Amazon, ...) - distinct from `source` above, which
  /// tracks the calling client, not the product's commercial origin. Both optional:
  /// most products are vendor-original and have neither.
  externalSource    String? @db.VarChar(40)
  externalProductId String? @db.VarChar(120)

  title       String  @db.VarChar(300)
  slug        String  @unique @db.VarChar(320)
  description String? @db.Text
  /// Bullet points shown above the fold.
  highlights  String[]

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?  @db.Uuid
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  status          ProductStatus @default(DRAFT)
  rejectionReason String?       @db.VarChar(500)
  approvedBy      String?       @db.Uuid
  publishedAt     DateTime?

  /// Cached from the cheapest active variant so listing pages can sort and filter by
  /// price without joining every variant row.
  minPrice Int @default(0)
  maxPrice Int @default(0)

  taxBps Int @default(1800)

  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)
  /// Denormalised popularity signal used for default sort. Updated asynchronously from
  /// order events - an approximate value refreshed off the write path.
  soldCount     Int   @default(0)
  viewCount     Int   @default(0)

  /// Free-form spec sheet (fabric, wattage, shelf life). Varies wildly by category, so
  /// a JSONB blob beats an EAV table here.
  specifications Json?
  searchKeywords String[]

  isReturnable   Boolean @default(true)
  returnWindowDays Int   @default(7)
  isCodAvailable Boolean @default(true)

  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(400)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  media    ProductMedia[]
  reviews  Review[]

  @@index([status, categoryId])
  @@index([vendorId, status])
  @@index([status, minPrice])
  @@index([status, soldCount])
  @@index([categoryId, status, ratingAverage])
  @@index([externalSource])
  @@map("products")
}

/// The buyable unit. Price and SKU live here, not on Product.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Stable identifier shared with inventory-service and every order line.
  sku String @unique @db.VarChar(64)

  title String @db.VarChar(200)
  /// The distinguishing axes: `{ "color": "Blue", "size": "M" }`.
  options Json

  /// Amounts are integer paise. `mrp` is the struck-through list price, `price` is what
  /// is charged; the discount percentage is derived, never stored, so the two can never
  /// disagree.
  mrp   Int
  price Int

  barcode String? @db.VarChar(64)
  weightGrams Int?
  /// Dimensions drive shipping cost bands.
  lengthMm Int?
  widthMm  Int?
  heightMm Int?

  imageUrl String? @db.VarChar(500)

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive])
  @@index([price])
  @@map("product_variants")
}

model ProductMedia {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type         MediaType @default(IMAGE)
  url          String    @db.VarChar(500)
  thumbnailUrl String?   @db.VarChar(500)
  altText      String?   @db.VarChar(200)
  displayOrder Int       @default(0)

  createdAt DateTime @default(now())

  @@index([productId, displayOrder])
  @@map("product_media")
}

model Review {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId   String @db.Uuid
  userName String @db.VarChar(160)

  /// Set when the reviewer actually bought the item, which is what makes the
  /// "verified purchase" badge meaningful. Validated against order-service on create.
  orderId String? @db.Uuid
  isVerifiedPurchase Boolean @default(false)

  rating  Int     @db.SmallInt
  title   String? @db.VarChar(200)
  comment String? @db.VarChar(4000)
  imageUrls String[]

  helpfulCount Int @default(0)
  isPublished  Boolean @default(true)
  /// Flagged reviews are hidden pending moderation rather than deleted.
  flagCount    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One review per user per product; a second submission edits the first.
  @@unique([productId, userId])
  @@index([productId, isPublished, createdAt])
  @@index([userId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Storefront merchandising (home page CMS)
//
// The home page is not a static layout: staff curate it the same way a Blinkit
// or Zepto ops team does — a rotating banner carousel plus any number of named
// "shelves" (an occasion push, a featured-category strip, a seasonal collection)
// made of image tiles. Both models are deliberately generic - `linkUrl` is a
// plain path or absolute URL rather than a typed reference to a category or
// product, so admins can point a tile anywhere (a category, a search query, an
// external page) without a schema change every time marketing wants something new.
// ---------------------------------------------------------------------------

/// One slide in the home page hero carousel.
model Banner {
  id String @id @default(uuid()) @db.Uuid

  /// Small all-caps label above the headline, e.g. "FESTIVE EDIT".
  eyebrow String? @db.VarChar(60)
  /// Main slide copy. Nullable: an image-only banner is valid.
  headline String? @db.VarChar(160)
  subcopy  String? @db.VarChar(240)

  ctaLabel String? @db.VarChar(40)
  /// Where the whole slide (and its CTA) links to - "/c/festive-sale" or a full URL.
  linkUrl  String  @db.VarChar(500)

  imageUrl String  @db.VarChar(500)
  imageAlt String  @db.VarChar(200)
  /// CSS object-position, so a photo's subject can be kept clear of the copy
  /// without cropping a different image per breakpoint.
  imagePosition String? @db.VarChar(40)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  /// Optional scheduling window for a campaign; null means "no bound on that side".
  startsAt DateTime?
  endsAt   DateTime?

  /// When set, the slide only shows while this occasion theme is live - a Diwali
  /// banner switches on and off with the Diwali theme instead of its own dates.
  themeId String?     @db.Uuid
  theme   StoreTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("banners")
}

/// A named, orderable shelf on the home page - "Shop by occasion", "Top
/// categories", "Monsoon must-haves". The section itself carries no imagery;
/// its tiles do.
model HomeSection {
  id String @id @default(uuid()) @db.Uuid

  title    String  @db.VarChar(120)
  subtitle String? @db.VarChar(200)
  /// Stable key for analytics and for linking a "See all" CTA; not shown to users.
  slug     String  @unique @db.VarChar(140)

  /// How the storefront renders this shelf - see HomeSectionLayout in
  /// libs/contracts: TILE_GRID | SPLIT_BANNERS | PRODUCT_GRID | PRODUCT_TABS |
  /// DEAL_OF_DAY. A string, not an enum, so adding a layout is a storefront
  /// change plus a contracts constant - no migration.
  layout String @default("TILE_GRID") @db.VarChar(30)
  /// Layout-specific knobs (tile shape, product query, countdown end, ...).
  /// Validated by HomeSectionConfigDto at the gateway; shape documented there.
  config Json?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  startsAt     DateTime?
  endsAt       DateTime?

  /// Same as Banner.themeId: shown only while that occasion theme is live.
  themeId String?     @db.Uuid
  theme   StoreTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiles HomeSectionTile[]

  @@index([isActive, displayOrder])
  @@map("home_sections")
}

/// One image tile within a HomeSection - "Diwali", "Monsoon", "Kitchen", or
/// whatever the section is themed around.
model HomeSectionTile {
  id        String      @id @default(uuid()) @db.Uuid
  sectionId String      @db.Uuid
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title    String  @db.VarChar(80)
  /// Secondary line - "Upto 45% off" on a split banner, unused on plain tiles.
  subtitle String? @db.VarChar(120)
  ctaLabel String? @db.VarChar(40)
  imageUrl String  @db.VarChar(500)
  imageAlt String  @db.VarChar(200)
  /// "/c/diwali-decor", "/search?q=monsoon", or an absolute URL.
  linkUrl  String  @db.VarChar(500)
  /// PRODUCT_TABS only: the category whose products this tab lists.
  categoryId String? @db.Uuid

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, isActive, displayOrder])
  @@map("home_section_tiles")
}

/// One link group in the site footer - "Bedroom Decor", "Policies", "Get in Touch".
/// Admin owns the full mega-footer this way: any number of columns, any links in
/// each, no hardcoded category list to keep in sync with the catalogue.
model FooterColumn {
  id String @id @default(uuid()) @db.Uuid

  title String @db.VarChar(80)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links FooterLink[]

  @@index([isActive, displayOrder])
  @@map("footer_columns")
}

model FooterLink {
  id       String       @id @default(uuid()) @db.Uuid
  columnId String       @db.Uuid
  column   FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  label String @db.VarChar(100)
  /// "/c/bedding", "/about", or an absolute URL.
  href  String @db.VarChar(500)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId, isActive, displayOrder])
  @@map("footer_links")
}

/// Singleton (one row, fixed id) for the footer content that isn't a link list -
/// social icons and the app-download CTA. Fetched alongside FooterColumn/Link
/// as one /catalog/footer response so the storefront needs one call, not three.
model FooterSettings {
  id String @id @default("default") @db.VarChar(20)

  /// [{ platform: "instagram", url: "https://..." }, ...]. Platform drives which
  /// icon renders; an unrecognised platform is skipped rather than breaking the row.
  socialLinks Json?

  appStoreUrl  String? @db.VarChar(500)
  playStoreUrl String? @db.VarChar(500)

  /// Shown under the columns, e.g. "(c) 2026 Nestora. All rights reserved."
  copyrightText String? @db.VarChar(200)

  updatedAt DateTime @updatedAt

  @@map("footer_settings")
}

/// A storefront-wide occasion skin - Diwali, Holi, Independence Day... At most one
/// is live at a time: the highest-priority active theme whose window contains now.
/// The storefront maps `preset` to its decorations (garland, tile shape, motifs)
/// and layers `colors` on top as CSS custom properties, so marketing can retune a
/// palette without a deploy while the artwork stays in code.
model StoreTheme {
  id String @id @default(uuid()) @db.Uuid

  /// Admin-facing label, e.g. "Diwali 2026".
  name   String @db.VarChar(80)
  /// DIWALI | HOLI | NAVRATRI | RAKHI | INDEPENDENCE | EID | CHRISTMAS | CUSTOM
  preset String @db.VarChar(30)
  /// Hex overrides: { primary, brandDark, highlight, gold, surface, wash }.
  colors Json?
  /// Replaces the announcement bar's USP line while live, e.g. "Diwali Sale is live - upto 75% off".
  announcement String? @db.VarChar(160)

  isActive Boolean   @default(false)
  /// Breaks ties when two windows overlap - higher wins.
  priority Int       @default(0)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banners  Banner[]
  sections HomeSection[]

  @@index([isActive, priority])
  @@map("store_themes")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  topic         String   @db.VarChar(120)
  eventType     String   @db.VarChar(120)
  eventVersion  Int      @default(1)
  partitionKey  String   @db.VarChar(120)
  payload       Json
  correlationId String?  @db.VarChar(128)
  causationId   String?  @db.VarChar(128)
  actorId       String?  @db.VarChar(64)
  /// Client source of the originating request (ANDROID, IOS, WEB, ...), for attribution.
  source        String?  @db.VarChar(20)

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId       String   @id @db.VarChar(64)
  consumerGroup String   @db.VarChar(120)
  processedAt   DateTime @default(now())

  @@index([processedAt])
  @@map("processed_events")
}
