// inventory-service owns stock, and stock is the hardest thing in commerce to get right.
//
// The core idea is that available stock is a derived value, not a stored one:
//
//     available = onHand - reserved
//
// `onHand` changes when goods physically move. `reserved` changes when a customer starts
// checkout. Keeping them as separate columns means a checkout can hold stock without
// pretending it has shipped, and a failed payment releases the hold without inventing
// units that were never there.
//
// Overselling is prevented by conditional updates - `UPDATE ... WHERE onHand - reserved
// >= :qty` - so the database, not application logic, is the arbiter under concurrency.

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@ecom-db/inventory"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WarehouseType {
  /// Regional fulfilment centre for standard multi-day shipping.
  FULFILMENT_CENTRE
  /// Neighbourhood dark store backing 10-20 minute delivery.
  DARK_STORE
  /// Vendor ships directly; we track stock but never hold it.
  VENDOR_MANAGED
}

enum StockMovementType {
  INBOUND
  RESERVE
  RELEASE
  COMMIT
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
}

model Warehouse {
  id   String        @id @default(uuid()) @db.Uuid
  code String        @unique @db.VarChar(20)
  name String        @db.VarChar(160)
  type WarehouseType @default(FULFILMENT_CENTRE)

  addressLine String  @db.VarChar(400)
  city        String  @db.VarChar(120)
  state       String  @db.VarChar(120)
  pincode     String  @db.VarChar(12)
  latitude    Float?
  longitude   Float?

  /// Pincodes this warehouse can deliver to. For dark stores this is a tight radius; for
  /// fulfilment centres it is a region. Drives warehouse selection at checkout.
  servicePincodes String[]

  /// Lower number wins when several warehouses can serve the same pincode.
  priority  Int     @default(100)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems StockItem[]
  movements  StockMovement[]

  @@index([isActive, type])
  @@map("warehouses")
}

/// Stock for one SKU in one warehouse. This is the row every checkout contends on, so it
/// is kept narrow and its indexes minimal.
model StockItem {
  id String @id @default(uuid()) @db.Uuid

  /// Mirrored from catalog-service. SKU is the contract between the two services.
  sku       String @db.VarChar(64)
  variantId String @db.Uuid
  productId String @db.Uuid
  vendorId  String @db.Uuid

  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  /// Physically present units.
  onHand   Int @default(0)
  /// Units promised to in-flight checkouts. Never exceeds onHand.
  reserved Int @default(0)
  /// Units picked but not yet dispatched - excluded from availability.
  allocated Int @default(0)

  /// Notify the vendor below this level.
  reorderLevel Int @default(10)
  /// Optional per-order cap for scarce or promotional items.
  maxOrderQuantity Int?

  isActive Boolean @default(true)

  lastRestockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reservationLines ReservationLine[]

  /// One stock row per SKU per warehouse - the constraint that makes the conditional
  /// decrement safe.
  @@unique([sku, warehouseId])
  @@index([sku])
  @@index([variantId])
  @@index([vendorId])
  @@index([warehouseId, isActive])
  @@map("stock_items")
}

/// A hold placed at checkout, released automatically if payment never completes.
model Reservation {
  id      String @id @default(uuid()) @db.Uuid
  /// Idempotency anchor: one reservation per order, so a retried checkout cannot hold
  /// the same stock twice.
  orderId String @unique @db.Uuid
  userId  String @db.Uuid

  status ReservationStatus @default(HELD)

  /// Swept by a scheduled job; the hold is worthless if it outlives the payment window.
  expiresAt   DateTime
  committedAt DateTime?
  releasedAt  DateTime?
  releaseReason String? @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines ReservationLine[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("reservations")
}

model ReservationLine {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  stockItemId String    @db.Uuid
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  sku      String @db.VarChar(64)
  quantity Int

  @@index([reservationId])
  @@index([stockItemId])
  @@map("reservation_lines")
}

/// Append-only ledger of every stock change.
///
/// The `StockItem` counters are the current balance; this is the audit trail that
/// explains how they got there. When a count is disputed - and it will be - this table
/// is the only way to reconstruct what happened.
model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  sku         String    @db.VarChar(64)
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  type     StockMovementType
  /// Signed: positive adds, negative removes.
  quantity Int
  /// Balance after this movement, so a point-in-time count needs no replay.
  onHandAfter   Int
  reservedAfter Int

  /// What caused it - an order id, a purchase order, an admin adjustment.
  referenceType String? @db.VarChar(40)
  referenceId   String? @db.VarChar(64)
  reason        String? @db.VarChar(300)
  actorId       String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([sku, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  topic         String   @db.VarChar(120)
  eventType     String   @db.VarChar(120)
  eventVersion  Int      @default(1)
  partitionKey  String   @db.VarChar(120)
  payload       Json
  correlationId String?  @db.VarChar(128)
  causationId   String?  @db.VarChar(128)
  actorId       String?  @db.VarChar(64)
  /// Client source of the originating request (ANDROID, IOS, WEB, ...), for attribution.
  source        String?  @db.VarChar(20)

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId       String   @id @db.VarChar(64)
  consumerGroup String   @db.VarChar(120)
  processedAt   DateTime @default(now())

  @@index([processedAt])
  @@map("processed_events")
}
