# ---------------------------------------------------------------------------
# Production settings for infra/docker-compose.prod.yml.
# On the server:  cp infra/.env.prod.example infra/.env.prod  and fill in every value.
# infra/.env.prod is git-ignored (.env.*); never commit it.
# ---------------------------------------------------------------------------

# Public hostname pointing at the server's public IP. Free option: a DuckDNS name
# (https://www.duckdns.org) - e.g. nestora.duckdns.org. Sub-subdomains resolve to
# the same IP automatically, so partner.<DOMAIN> and admin.<DOMAIN> need no extra DNS.
DOMAIN=yourname.duckdns.org
# Let's Encrypt account email (expiry notices only).
ACME_EMAIL=you@example.com

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=ecom
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Generate each: openssl rand -base64 48   (must be >= 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Kafka ------------------------------------------------------------------
# Any 22-char base64 id; keep it stable once the volume exists.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- SMS (OTP delivery) -----------------------------------------------------
# console = OTPs are only written to the notification-service log (read them with
#           `docker compose ... logs notification-service`). Fine for a private demo.
# msg91   = real SMS; needs a DLT-registered template.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Payments ---------------------------------------------------------------
# Production refuses the mock gateway. Razorpay TEST keys work and move no money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Push (optional) --------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Support assistant (Claude). Leave empty to run support as tickets-only.
ANTHROPIC_API_KEY=
