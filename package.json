{
  "name": "ecommerce",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "frontend/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d postgres redis kafka kafka-ui",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "stack:up": "docker compose --env-file .env -f infra/docker-compose.yml --profile app up -d --build",
    "stack:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "db:generate": "node tools/scripts/prisma.mjs generate",
    "db:push": "node tools/scripts/prisma.mjs db push",
    "db:migrate": "node tools/scripts/prisma.mjs migrate dev",
    "db:deploy": "node tools/scripts/prisma.mjs migrate deploy",
    "db:seed": "node tools/scripts/prisma.mjs seed",
    "db:studio": "node tools/scripts/prisma.mjs studio",
    "kafka:topics": "node tools/scripts/create-topics.mjs",
    "postinstall": "npm run db:generate",
    "stack:down": "docker compose --env-file .env -f infra/docker-compose.yml --profile app down"
  },
  "dependencies": {
